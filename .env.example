# 선택 사항: 기본값은 src/config.ts 에 있어서 .env 없이도 실행된다.
# 다른 서버를 쓰거나 데모로 돌릴 때만 이 파일을 .env 로 복사해서 값을 바꾼다. (.env 는 git에 올라가지 않는다)

# 사진 분석 서버 주소. demo 로 두면 데모 결과를 보여준다.
# EXPO_PUBLIC_ANALYZE_URL=demo
EXPO_PUBLIC_ANALYZE_URL=

# Supabase publishable 키 (sb_publishable_... 로 시작, 공개돼도 되는 키).
# Gemini API 키는 여기에 넣지 않는다. 서버 secrets(GEMINI_API_KEY)로만 관리한다.
EXPO_PUBLIC_SUPABASE_KEY=
