# 이 파일을 .env 로 복사해서 값을 채운다. (.env 는 git에 올라가지 않는다)

# 사진 분석 서버 주소. 비워 두면 데모 결과를 보여준다.
# 예: https://<project-ref>.supabase.co/functions/v1/analyze-fridge
EXPO_PUBLIC_ANALYZE_URL=

# Supabase publishable 키 (sb_publishable_... 로 시작, 공개돼도 되는 키).
# Gemini API 키는 여기에 넣지 않는다. 서버 secrets(GEMINI_API_KEY)로만 관리한다.
EXPO_PUBLIC_SUPABASE_KEY=
